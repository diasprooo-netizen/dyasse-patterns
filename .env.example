# Supabase public browser/server credentials
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only admin email used by Next.js route protection.
# Also add this same lowercased email to public.admin_users in Supabase.
ADMIN_EMAIL=

# Public app URL used for metadata and absolute redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public PayPal client ID for future PayPal SDK integration.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
